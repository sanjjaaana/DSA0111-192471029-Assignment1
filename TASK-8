#include <iostream>
#include <iomanip>
#include <limits>
using namespace std;

int main()
{
    int zone;
    int hour;
    int passengers;

    cout << "METRO JOURNEY REPORT" << endl;
    cout << "--------------------" << endl;

    cout << "Enter Zone (1-3): ";

    while (!(cin >> zone))
    {
        cout << "Invalid input. Enter a number: ";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }

    cout << "Enter Journey Hour (0-23): ";

    while (!(cin >> hour))
    {
        cout << "Invalid input. Enter a number: ";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }

    cout << "Enter Number of Passengers: ";

    while (!(cin >> passengers))
    {
        cout << "Invalid input. Enter a number: ";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }

    if (zone < 1 || zone > 3 || hour < 0 ||
        hour > 23 || passengers <= 0)
    {
        cout << "Invalid journey details" << endl;
        return 0;
    }

    int fare[] = {1000, 2000, 3000};

    long long total = fare[zone - 1] * passengers;

    bool peak = (hour >= 8 && hour < 10) ||
                (hour >= 17 && hour < 20);

    if (peak)
    {
        total = total + total * 20 / 100;
    }

    cout << fixed << setprecision(2);

    cout << "\nJOURNEY DETAILS" << endl;
    cout << "--------------------" << endl;
    cout << "Zone: " << zone << endl;
    cout << "Hour: " << hour << endl;
    cout << "Passengers: " << passengers << endl;

    cout << "Total Fare: Rs. "
         << static_cast<double>(total) / 100 << endl;

    return 0;
}
